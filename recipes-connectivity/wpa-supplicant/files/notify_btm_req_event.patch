+/**
+ * wpas_dbus_signal_bss_tm_req_event - Emit a BSS transition request event
+ * @wpa_s: %wpa_supplicant network interface data
+ * @request_mode: BSS Transition Management Request Mode bitfield
+ * @disassoc_timer: Disassociation timer
+ * @validity_interval: Candidate list validity interval
+ * @list: Candidate BSS entries parsed from the request; must not be %NULL,
+ *        and @items must not be %NULL when @count is non-zero
+ *
+ * Sends the BSS_TM_Req_Event D-Bus signal with the current BSSID and
+ * frequency, request flags, timer and candidate entries. This reports the
+ * request to listeners; it does not initiate or change roaming. No signal is
+ * sent if the D-Bus interface or object path is unavailable, the list is
+ * invalid, or the signal cannot be constructed.
+ */
+void wpas_dbus_signal_bss_tm_req_event(struct wpa_supplicant *wpa_s,
+				    u8 request_mode, u16 disassoc_timer,
+				    u8 validity_interval,
+				    const struct wpas_btm_candidate_list *list)
+{
+	struct wpas_dbus_priv *iface = wpa_s->global->dbus;
+	DBusMessage *msg;
+	DBusMessageIter iter, payload, bssid_array, array, entry;
+	const unsigned char *bssid = wpa_s->bssid;
+	dbus_uint16_t current_freq = 0;
+	unsigned char validity = validity_interval;
+	dbus_bool_t abridged = (request_mode & WNM_BSS_TM_REQ_ABRIDGED) ? TRUE : FALSE;
+	dbus_bool_t ess_imminent =
+		(request_mode & WNM_BSS_TM_REQ_ESS_DISASSOC_IMMINENT) ? TRUE : FALSE;
+	dbus_bool_t bss_imminent =
+		(request_mode & WNM_BSS_TM_REQ_DISASSOC_IMMINENT) ? TRUE : FALSE;
+	dbus_bool_t bss_timed =
+		(request_mode & WNM_BSS_TM_REQ_BSS_TERMINATION_INCLUDED) ? TRUE : FALSE;
+	dbus_uint16_t timer = disassoc_timer;
+	dbus_uint32_t count;
+	u32 i;
+
+	if (!iface || !wpa_s->dbus_new_path || !list ||
+	    (list->count && !list->items))
+	{
+            wpa_printf(MSG_DEBUG, "%s: skipping BTM signal "
+                  "(dbus=%s path=%s list=%s count=%u items=%s)",
+                   __func__,
+                   iface ? "ready" : "unavailable",
+                   wpa_s->dbus_new_path ? "ready" : "unavailable",
+                   list ? "present" : "null",
+                   list ? list->count : 0,
+                   (list && list->items) ? "present" : "null");
+		return;
+	}
+
+	if (wpa_s->current_bss && wpa_s->current_bss->freq > 0)
+		current_freq = wpa_s->current_bss->freq;
+	else if (wpa_s->assoc_freq > 0)
+		current_freq = wpa_s->assoc_freq;
+
+	count = list->count;
+	msg = dbus_message_new_signal(wpa_s->dbus_new_path,
+				      WPAS_DBUS_NEW_IFACE_INTERFACE,
+				      "BSS_TM_Req_Event");
+	if (!msg)
+		return;
+
+	dbus_message_iter_init_append(msg, &iter);
+	if (!dbus_message_iter_open_container(&iter, DBUS_TYPE_STRUCT,
+					      NULL, &payload) ||
+	    !dbus_message_iter_open_container(&payload, DBUS_TYPE_ARRAY,
+					      DBUS_TYPE_BYTE_AS_STRING,
+					      &bssid_array) ||
+	    !dbus_message_iter_append_fixed_array(&bssid_array, DBUS_TYPE_BYTE,
+						  &bssid, ETH_ALEN) ||
+	    !dbus_message_iter_close_container(&payload, &bssid_array) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_UINT16,
+						&current_freq) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_BYTE,
+						&validity) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_BOOLEAN,
+						&abridged) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_BOOLEAN,
+						&ess_imminent) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_BOOLEAN,
+						&bss_imminent) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_BOOLEAN,
+						&bss_timed) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_UINT16,
+						&timer) ||
+	    !dbus_message_iter_append_basic(&payload, DBUS_TYPE_UINT32,
+						&count) ||
+	    !dbus_message_iter_open_container(&payload, DBUS_TYPE_ARRAY,
+						  "(ayqy)", &array))
+		goto error;
+
+	for (i = 0; i < list->count; i++) {
+		const struct wpas_btm_candidate *candidate = &list->items[i];
+		const unsigned char *candidate_bssid = candidate->bssid;
+		dbus_uint16_t candidate_freq = candidate->frequency_mhz;
+		unsigned char channel = candidate->channel;
+		DBusMessageIter candidate_bssid_array;
+
+		if (!dbus_message_iter_open_container(&array, DBUS_TYPE_STRUCT,
+						      NULL, &entry) ||
+		    !dbus_message_iter_open_container(&entry, DBUS_TYPE_ARRAY,
+						      DBUS_TYPE_BYTE_AS_STRING,
+						      &candidate_bssid_array) ||
+		    !dbus_message_iter_append_fixed_array(&candidate_bssid_array,
+							  DBUS_TYPE_BYTE,
+							  &candidate_bssid,
+							  ETH_ALEN) ||
+		    !dbus_message_iter_close_container(&entry,
+						   &candidate_bssid_array) ||
+		    !dbus_message_iter_append_basic(&entry, DBUS_TYPE_UINT16,
+							&candidate_freq) ||
+		    !dbus_message_iter_append_basic(&entry, DBUS_TYPE_BYTE,
+							&channel) ||
+		    !dbus_message_iter_close_container(&array, &entry))
+			goto error;
+	}
+
+	if (!dbus_message_iter_close_container(&payload, &array) ||
+	    !dbus_message_iter_close_container(&iter, &payload))
+		goto error;
+
+	dbus_connection_send(iface->con, msg, NULL);
+	dbus_message_unref(msg);
+	return;
+
+error:
+	wpa_printf(MSG_ERROR, "dbus: Failed to construct BTM request event signal");
+	dbus_message_unref(msg);
+}
 
