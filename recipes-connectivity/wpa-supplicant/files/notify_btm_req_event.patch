+static void wnm_notify_bss_tm_req_event(struct wpa_supplicant *wpa_s,
+                 u8 request_mode, u16 disassoc_timer,
+                 u8 validity_interval,
+                 int include_candidates)
+{
+    struct wpas_btm_candidate candidates[WNM_MAX_NEIGHBOR_REPORT];
+    struct wpas_btm_candidate_list list;
+    unsigned int i;
+
+    list.count = include_candidates ? wpa_s->wnm_num_neighbor_report : 0;
+    list.items = list.count ? candidates : NULL;
+
+    for (i = 0; i < list.count; i++) {
+        const struct neighbor_report *report =
+            &wpa_s->wnm_neighbor_report_elements[i];
+
+        os_memcpy(candidates[i].bssid, report->bssid, ETH_ALEN);
+        candidates[i].channel = report->channel_number;
+        candidates[i].frequency_mhz = report->freq > 0 ? report->freq : 0;
+    }
+
+    wpas_notify_bss_tm_req_event(wpa_s, request_mode, disassoc_timer,
+                  validity_interval, &list);
+}
 
