+/**
+ * struct wpas_btm_candidate - Candidate BSS from a BTM request
+ * @bssid: Candidate BSSID
+ * @channel: Channel number
+ * @frequency_mhz: Candidate operating frequency in MHz
+ */
+struct wpas_btm_candidate {
+	u8 bssid[ETH_ALEN];
+	u32 channel;
+	u32 frequency_mhz;
+};
+
+/**
+ * struct wpas_btm_candidate_list - Candidate BSS entries from a BTM request
+ * @count: Number of entries in @items
+ * @items: Array of candidates.
+ */
+struct wpas_btm_candidate_list {
+	u32 count;
+	const struct wpas_btm_candidate *items;
+};
 
 /**
